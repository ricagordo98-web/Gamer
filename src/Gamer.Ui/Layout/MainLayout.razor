@inherits LayoutComponentBase
@implements IDisposable
@inject AuthSession Session
@inject GameLibrary Library
@inject CartState Cart
@inject AlertMonitor Alerts
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Routing

@if (_ready && Session.IsAuthenticated)
{
    <div class="app">
        <aside class="sidebar">
            <div class="brand"><Logo Size="36" /><span>Gamer</span></div>
            <nav>
                <span class="nav-group">Jogar</span>
                <NavLink class="nav-item" href="" Match="NavLinkMatch.All"><Icon Name="dashboard" /> Painel</NavLink>
                <NavLink class="nav-item" href="games"><Icon Name="games" /> Biblioteca</NavLink>
                <NavLink class="nav-item" href="random"><Icon Name="dice" /> Sorteio</NavLink>

                <span class="nav-group">Comprar</span>
                <NavLink class="@("nav-item " + ShopClass)" href="promotions"><Icon Name="store" /> Loja @CartBadge</NavLink>

                <span class="nav-group">Sistema</span>
                <NavLink class="nav-item" href="settings"><Icon Name="settings" /> Definições</NavLink>
            </nav>
        </aside>

        <main class="main">@Body</main>

        <nav class="tabbar">
            <NavLink class="tab" href="" Match="NavLinkMatch.All"><Icon Name="dashboard" Size="22" /><span>Painel</span></NavLink>
            <NavLink class="tab" href="games"><Icon Name="games" Size="22" /><span>Biblioteca</span></NavLink>
            <NavLink class="tab" href="random"><Icon Name="dice" Size="22" /><span>Sorteio</span></NavLink>
            <NavLink class="@("tab " + ShopClass)" href="promotions"><Icon Name="store" Size="22" /><span>Loja</span>@CartBadge</NavLink>
            <NavLink class="tab" href="settings"><Icon Name="settings" Size="22" /><span>Definições</span></NavLink>
        </nav>
    </div>
}

@code {
    private static readonly string[] ShopRoutes = ["promotions", "stores", "deals", "wishlist", "steam", "cart"];

    private bool _ready;

    private string ShopClass => IsShopRoute() ? "shop-active" : string.Empty;

    private bool IsShopRoute()
    {
        string path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        return ShopRoutes.Contains(path, StringComparer.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Cart.Changed += OnCartChanged;
        await Session.InitializeAsync();
        _ready = true;

        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("login");
            return;
        }

        Alerts.Start();
    }

    private RenderFragment CartBadge => builder =>
    {
        if (Cart.AlertCount > 0)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "nav-badge");
            builder.AddContent(2, Cart.AlertCount);
            builder.CloseElement();
        }
    };

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        Cart.Changed -= OnCartChanged;
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private void OnSessionChanged()
    {
        if (Session.IsAuthenticated)
        {
            InvokeAsync(Alerts.Start);
            return;
        }

        InvokeAsync(() =>
        {
            Library.Reset();
            Cart.Reset();
            Navigation.NavigateTo("login");
        });
    }
}
