@page "/games"
@implements IDisposable
@inject GameLibrary Library

@{
    GameFilter filter = Library.Filter;
    List<GameDto> visible = filter.Apply(Library.Games).ToList();
    List<GameDto> forCounts = filter.ApplyExceptStatus(Library.Games).ToList();
    List<GameDto> forPlatforms = filter.ApplyExceptPlatform(Library.Games).Where(g => filter.Status is null || g.Status == filter.Status).ToList();
    List<string> families = Library.Platforms.Select(p => p.Family).Distinct().ToList();
    IEnumerable<PlatformDto> shownPlatforms = Library.Platforms
        .Where(p => (filter.Family is null || p.Family == filter.Family) && forPlatforms.Any(g => g.PlatformId == p.Id));
}

<header class="page-header">
    <h1>Biblioteca <small>@visible.Count</small></h1>
    <div class="header-actions desktop-only">
        <button class="btn" @onclick="() => _bulk = true"><Icon Name="upload" Size="18" /> Adicionar vários</button>
        <button class="btn btn-primary" @onclick="() => _adding = true"><Icon Name="plus" Size="18" /> Novo jogo</button>
    </div>
</header>

<div class="toolbar">
    <label class="search">
        <Icon Name="search" Size="18" />
        <input type="search" placeholder="Procurar jogo…" @bind="filter.Search" @bind:event="oninput" />
    </label>

    <div class="filter-block">
        <span class="filter-label">Plataforma</span>
        <div class="chips">
            <button class="chip @(filter.Family is null ? "on" : string.Empty)" @onclick="() => filter.Family = null">Todas <b>@Library.Games.Count</b></button>
            @foreach (string family in families)
            {
                <button class="chip fam-chip fam-@family.ToLowerInvariant() @(filter.Family == family ? "on" : string.Empty)" @onclick="() => filter.Family = family">
                    @FamilyLabel(family) <b>@Library.Games.Count(g => g.PlatformFamily == family)</b>
                </button>
            }
        </div>
        @if (filter.Family is not null || filter.PlatformId is not null)
        {
            <div class="chips sub-chips">
                @foreach (PlatformDto platform in shownPlatforms)
                {
                    <button class="chip plat-chip plat-@PlatformChip.Slug(platform.Name) @(filter.PlatformId == platform.Id ? "on" : string.Empty)"
                            @onclick="() => filter.PlatformId = filter.PlatformId == platform.Id ? null : platform.Id">
                        @platform.Name <b>@forPlatforms.Count(g => g.PlatformId == platform.Id)</b>
                    </button>
                }
            </div>
        }
    </div>

    <div class="filter-block">
        <span class="filter-label">Estado</span>
        <div class="chips">
            <button class="chip @(filter.Status is null ? "on" : string.Empty)" @onclick="() => filter.Status = null">Todos <b>@forCounts.Count</b></button>
            @foreach (GameStatus status in Enum.GetValues<GameStatus>())
            {
                <button class="chip st-@status.CssClass() @(filter.Status == status ? "on" : string.Empty)" @onclick="() => filter.Status = status">
                    @status.Label() <b>@forCounts.Count(g => g.Status == status)</b>
                </button>
            }
        </div>
    </div>

    <div class="filters-row">
        <button class="chip @(filter.OnlyDeck ? "on" : string.Empty)" @onclick="() => filter.OnlyDeck = !filter.OnlyDeck">
            <Icon Name="deck" Size="16" /> Deck
        </button>
        <select class="input sort-select" @bind="filter.Sort" aria-label="Ordenar">
            <option value="@GameSort.Title">Ordenar: A–Z</option>
            <option value="@GameSort.Platform">Ordenar: plataforma</option>
            <option value="@GameSort.Status">Ordenar: estado</option>
        </select>
        @if (filter.IsActive)
        {
            <button class="chip" @onclick="filter.Reset">Limpar</button>
        }
    </div>
</div>

@if (Library.IsLoading && !Library.IsLoaded)
{
    <div class="empty"><div class="spinner"></div><p>A carregar…</p></div>
}
else if (Library.LoadError is not null)
{
    <div class="empty">
        <p>@Library.LoadError</p>
        <button class="btn btn-primary" @onclick="() => Library.ReloadAsync(CancellationToken.None)">Tentar de novo</button>
    </div>
}
else if (visible.Count == 0)
{
    <div class="empty">
        <p>Nenhum jogo encontrado.</p>
        @if (filter.IsActive)
        {
            <button class="btn" @onclick="filter.Reset">Limpar filtros</button>
        }
    </div>
}
else
{
    <Virtualize Items="visible" Context="game" ItemSize="80" OverscanCount="8">
        <GameCard @key="game.Id" Game="game" OnOpen="() => _editing = game" OnAdvance="() => AdvanceAsync(game)" />
    </Virtualize>
}

<button class="fab fab-secondary mobile-only" @onclick="() => _bulk = true" aria-label="Adicionar vários"><Icon Name="upload" Size="22" /></button>
<button class="fab mobile-only" @onclick="() => _adding = true" aria-label="Novo jogo"><Icon Name="plus" Size="26" /></button>

@if (_bulk)
{
    <BulkAddDialog OnClose="() => _bulk = false" />
}
else if (_adding)
{
    <GameEditor OnClose="() => _adding = false" />
}
else if (_editing is not null)
{
    <GameEditor Game="_editing" OnClose="() => _editing = null" />
}

@code {
    private GameDto? _editing;
    private bool _adding;
    private bool _bulk;

    protected override async Task OnInitializedAsync()
    {
        Library.Changed += OnLibraryChanged;
        await Library.EnsureLoadedAsync(CancellationToken.None);
    }

    public void Dispose() => Library.Changed -= OnLibraryChanged;

    private void OnLibraryChanged() => InvokeAsync(StateHasChanged);

    private static string FamilyLabel(string family) => family switch
    {
        "PC" => "PC · lojas",
        "Other" => "Outras",
        _ => family,
    };

    private Task AdvanceAsync(GameDto game) => Library.SetStatusAsync(game, game.Status.Next(), CancellationToken.None);
}
