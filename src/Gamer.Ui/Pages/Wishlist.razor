@page "/wishlist"
@page "/steam"
@inject IGamerApi Api
@inject GameLibrary Library
@inject ToastService Toasts

<ShopTabs />

<header class="page-header">
    <h1>Wishlist Steam <small>@_wishlist.Count</small></h1>
    <button class="btn" @onclick="SyncAsync" disabled="@_syncing">
        <Icon Name="refresh" Size="18" /> @(_syncing ? "A sincronizar…" : "Sincronizar Steam")
    </button>
</header>

<p class="muted deal-help">Os jogos da tua wishlist da Steam. Os da tua biblioteca Steam são adicionados automaticamente à Biblioteca ao sincronizar. Para saberes onde estão mais baratos, usa Comparar preços.</p>

<label class="search steam-search">
    <Icon Name="search" Size="18" />
    <input type="search" placeholder="Filtrar…" @bind="_filter" @bind:event="oninput" />
</label>

@if (_loading)
{
    <div class="empty"><div class="spinner"></div><p>A carregar…</p></div>
}
else if (_error is not null)
{
    <div class="empty">
        <p>@_error</p>
        <button class="btn btn-primary" @onclick="LoadAsync">Tentar de novo</button>
    </div>
}
else if (_wishlist.Count == 0)
{
    <div class="empty"><p>Wishlist vazia. Configura a Steam nas Definições e sincroniza.</p></div>
}
else
{
    @foreach (WishlistItemDto item in _wishlist.Where(i => Matches(i.Title)))
    {
        <div class="card steam-row">
            <span class="game-title">@item.Title</span>
            @if (item.AddedAt is { } added)
            {
                <span class="muted">@added.ToLocalTime().ToString("dd/MM/yyyy")</span>
            }
        </div>
    }
}

@code {
    private List<WishlistItemDto> _wishlist = [];
    private string _filter = string.Empty;
    private string? _error;
    private bool _loading = true;
    private bool _syncing;

    protected override Task OnInitializedAsync() => LoadAsync();

    private bool Matches(string title) =>
        string.IsNullOrWhiteSpace(_filter) || title.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _wishlist = (await Api.GetWishlistAsync(CancellationToken.None)).ToList();
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SyncAsync()
    {
        _syncing = true;
        try
        {
            SteamSyncResultDto result = await Api.SyncSteamAsync(CancellationToken.None);
            await LoadAsync();
            await Library.ReloadAsync(CancellationToken.None);
            Toasts.Success($"{result.WishlistCount} jogos na wishlist; {result.NewGames} novos na Biblioteca.");
        }
        catch (ApiException exception)
        {
            Toasts.Error(exception.Message);
        }
        finally
        {
            _syncing = false;
        }
    }
}
