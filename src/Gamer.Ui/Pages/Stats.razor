@page "/stats"
@implements IDisposable
@inject IGamerApi Api
@inject GameLibrary Library
@inject ToastService Toasts

<header class="page-header">
    <h1>Estatísticas</h1>
    <div class="header-actions-inline">
        <button class="btn" @onclick="EnrichAsync" disabled="@(_stats is null || _stats.Enrichment.Running)" title="Vai buscar avaliações, géneros, preços e tags de cada jogo Steam">
            <Icon Name="refresh" Size="18" /> @(_stats?.Enrichment.Running == true ? $"A atualizar fichas ({_stats.Enrichment.Done}/{_stats.Enrichment.Total})" : "Atualizar fichas")
        </button>
    </div>
</header>

@if (_loading)
{
    <div class="empty"><div class="spinner"></div><p>A calcular…</p></div>
}
else if (_error is not null)
{
    <div class="empty">
        <p>@_error</p>
        <button class="btn btn-primary" @onclick="LoadAsync">Tentar de novo</button>
    </div>
}
else if (_stats is null || _stats.SteamGames == 0)
{
    <div class="empty"><p>Ainda não há jogos Steam. Configura a Steam nas Definições e sincroniza para veres horas jogadas, valor da conta e muito mais.</p></div>
}
else
{
    DashboardStats library = DashboardStats.From(Library.Games.ToList());

    <section class="tiles tiles-5">
        <div class="tile"><strong>@_stats.SteamGames</strong><span>Jogos Steam</span></div>
        <div class="tile st-playing"><strong>@StatsFormat.Hours(_stats.TotalMinutes)</strong><span>Horas jogadas</span></div>
        <div class="tile st-completed"><strong>@(_stats.PricedGames == 0 ? "—" : DealFormat.Money(_stats.ValueCurrent, _stats.Currency))</strong><span>Valor da conta (agora)</span></div>
        <div class="tile st-backlog"><strong>@_stats.NeverPlayed</strong><span>Nunca abertos</span></div>
        <div class="tile deck"><strong>@(_stats.PricedGames == 0 ? "—" : StatsFormat.PerHour(_stats.ValueCurrent, _stats.TotalMinutes, _stats.Currency))</strong><span>Custo por hora</span></div>
    </section>

    @if (_stats.PricedGames > 0)
    {
        <p class="muted stats-note">
            Ao preço normal a tua biblioteca vale @DealFormat.Money(_stats.ValueNormal, _stats.Currency) e ao preço de hoje @DealFormat.Money(_stats.ValueCurrent, _stats.Currency),
            contando @_stats.PricedGames de @_stats.SteamGames jogos com preço. Jogaste @StatsFormat.Hours(_stats.RecentMinutes) nas últimas duas semanas.
        </p>
    }
    else
    {
        <p class="muted stats-note">Valor, géneros e avaliações aparecem depois de atualizares as fichas (@_stats.InfoGames de @_stats.SteamGames feitas).</p>
    }

    <div class="stats-columns">
        <section>
            <h3 class="section-title">Por estado</h3>
            <div class="card">
                <BarList Items="StatusBars(library)" />
            </div>
        </section>
        <section>
            <h3 class="section-title">Por plataforma</h3>
            <div class="card">
                <BarList Items="library.ByPlatform.Select(p => new BarItem(p.Name, p.Count, p.Count.ToString())).ToList()" Color="var(--accent-2)" />
            </div>
        </section>
        @if (_stats.Genres.Count > 0)
        {
            <section>
                <h3 class="section-title">Géneros mais comuns</h3>
                <div class="card">
                    <BarList Items="GenreBars(_stats)" Color="var(--price)" />
                </div>
            </section>
        }
    </div>

    <div class="stats-columns">
        <section>
            <h3 class="section-title">Mais jogados</h3>
            <div class="card stat-list">
                @foreach (StatsGameDto game in _stats.TopPlayed.Where(g => g.Minutes > 0))
                {
                    <button class="stat-row" @onclick="() => Open(game)">
                        <span class="stat-title">@game.Title</span>
                        <span class="stat-meta">@StatsFormat.Hours(game.Minutes)</span>
                    </button>
                }
            </div>
        </section>
        <section>
            <h3 class="section-title">Jogados recentemente</h3>
            <div class="card stat-list">
                @if (_stats.Recent.Count == 0)
                {
                    <p class="muted">Nada nas últimas duas semanas.</p>
                }
                @foreach (StatsGameDto game in _stats.Recent)
                {
                    <button class="stat-row" @onclick="() => Open(game)">
                        <span class="stat-title">@game.Title</span>
                        <span class="stat-meta">@StatsFormat.Hours(game.RecentMinutes) · @StatsFormat.LastPlayed(game.LastPlayedAt, DateTimeOffset.UtcNow)@PlayersText(game.AppId)</span>
                    </button>
                }
            </div>
        </section>
        <section>
            <h3 class="section-title">Comprados e nunca abertos</h3>
            <div class="card stat-list">
                @if (_stats.NeverPlayedTop.Count == 0)
                {
                    <p class="muted">Já abriste todos. Respeito.</p>
                }
                @foreach (StatsGameDto game in _stats.NeverPlayedTop)
                {
                    <button class="stat-row" @onclick="() => Open(game)">
                        <span class="stat-title">@game.Title</span>
                        <span class="stat-meta">@(game.NormalPrice is > 0 ? DealFormat.Money(game.NormalPrice.Value, _stats.Currency) : string.Empty)</span>
                    </button>
                }
            </div>
        </section>
        <section>
            <h3 class="section-title">As tuas melhores notas</h3>
            <div class="card stat-list">
                @{
                    List<GameDto> rated = Library.Games.Where(g => g.Rating is not null).OrderByDescending(g => g.Rating).ThenBy(g => g.Title).Take(10).ToList();
                }
                @if (rated.Count == 0)
                {
                    <p class="muted">Ainda não deste notas a nenhum jogo.</p>
                }
                @foreach (GameDto game in rated)
                {
                    <div class="stat-row static">
                        <span class="stat-title">@game.Title</span>
                        <span class="stat-meta">@game.Rating/10 · @game.PlatformName</span>
                    </div>
                }
            </div>
        </section>
    </div>
}

@if (_open is not null)
{
    <SteamGameDetail AppId="_open.AppId" Title="@_open.Title" OnClose="() => _open = null" />
}

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(4);

    private StatsDto? _stats;
    private string? _error;
    private bool _loading = true;
    private bool _disposed;
    private StatsGameDto? _open;
    private Dictionary<long, int?> _players = [];

    public void Dispose() => _disposed = true;

    protected override async Task OnInitializedAsync()
    {
        await Library.EnsureLoadedAsync(CancellationToken.None);
        await LoadAsync();
    }

    private static IReadOnlyList<BarItem> StatusBars(DashboardStats library) =>
    [
        new("Backlog", library.Backlog, library.Backlog.ToString()),
        new("A jogar", library.Playing, library.Playing.ToString()),
        new("Terminados", library.Completed, library.Completed.ToString()),
    ];

    private static IReadOnlyList<BarItem> GenreBars(StatsDto stats) =>
        stats.Genres.Select(g => new BarItem(g.Name, g.Count, $"{g.Count} · {StatsFormat.Hours(g.Minutes)}")).ToList();

    private void Open(StatsGameDto game) => _open = game;

    private string PlayersText(long appId) =>
        _players.TryGetValue(appId, out int? players) && players is not null ? $" · {StatsFormat.Players(players)}" : string.Empty;

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _stats = await Api.GetStatsAsync(CancellationToken.None);
            _loading = false;
            await LoadPlayersAsync();
            _ = PollAsync();
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
            _loading = false;
        }
    }

    private async Task LoadPlayersAsync()
    {
        if (_stats is null || _stats.Recent.Count == 0)
        {
            return;
        }

        try
        {
            _players = (await Api.GetPlayersNowAsync(_stats.Recent.Select(g => g.AppId), CancellationToken.None)).ToDictionary(p => p.AppId, p => p.Players);
        }
        catch (ApiException)
        {
        }
    }

    private async Task EnrichAsync()
    {
        try
        {
            EnrichmentStatusDto status = await Api.StartEnrichmentAsync(CancellationToken.None);
            if (_stats is not null)
            {
                _stats = _stats with { Enrichment = status };
            }

            _ = PollAsync();
        }
        catch (ApiException exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private async Task PollAsync()
    {
        while (!_disposed && _stats?.Enrichment.Running == true)
        {
            await Task.Delay(PollInterval);
            try
            {
                _stats = await Api.GetStatsAsync(CancellationToken.None);
                await InvokeAsync(StateHasChanged);
            }
            catch (ApiException)
            {
                return;
            }
        }
    }
}
