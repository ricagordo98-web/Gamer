@page "/stats"
@implements IDisposable
@inject IGamerApi Api
@inject GameLibrary Library
@inject ToastService Toasts

<header class="page-header">
    <h1>Estatísticas</h1>
    <div class="header-actions-inline">
        <button class="btn" @onclick="EnrichAsync" disabled="@(_stats is null || _stats.Enrichment.Running)" title="Atualiza os preços atuais de todos os jogos e vai buscar as fichas que faltam (avaliações, géneros, tags)">
            <Icon Name="refresh" Size="18" /> @(_stats?.Enrichment.Running == true ? "A atualizar…" : "Atualizar preços e fichas")
        </button>
    </div>
</header>

@if (_stats is { SteamGames: > 0 })
{
    <p class="muted promo-updated">@(_stats.PricesUpdatedAt is { } updated ? $"Preços atualizados {DealFormat.Ago(updated, DateTimeOffset.UtcNow)}. Atualizam sozinhos ao ritmo definido nas Definições, ou à mão com o botão." : "Preços por atualizar: carrega em \"Atualizar preços e fichas\".")</p>
}

@if (_stats?.Enrichment.Running == true)
{
    <div class="card enrich-progress">
        <span>A atualizar preços e fichas: @_stats.Enrichment.Done de @_stats.Enrichment.Total</span>
        <div class="bar-track"><div class="bar-fill" style="--fam:var(--accent);width:@(_stats.Enrichment.Total == 0 ? 0 : 100 * _stats.Enrichment.Done / _stats.Enrichment.Total)%"></div></div>
    </div>
}

@if (_loading)
{
    <div class="empty"><div class="spinner"></div><p>A calcular…</p></div>
}
else if (_error is not null)
{
    <div class="empty">
        <p>@_error</p>
        <button class="btn btn-primary" @onclick="LoadAsync">Tentar de novo</button>
    </div>
}
else if (_stats is null || _stats.SteamGames == 0)
{
    <div class="empty"><p>Ainda não há jogos Steam. Configura a Steam nas Definições e sincroniza para veres horas jogadas, valor da conta e muito mais.</p></div>
}
else
{
    <div class="view-switch stats-tabs">
        @foreach ((string key, string label, string icon) in Tabs)
        {
            <button class="@(_tab == key ? "on" : string.Empty)" @onclick="() => _tab = key"><Icon Name="@icon" Size="18" /> @label</button>
        }
    </div>

    @switch (_tab)
    {
        case "library":
            <StatsLibrary />
            break;
        case "steam":
            <StatsSteam Stats="_stats" OnOpen="Open" />
            break;
        case "games":
            <StatsGamesTable Currency="@_stats.Currency" OnOpen="Open" />
            break;
        default:
            <StatsOverview Stats="_stats" Players="_players" OnOpen="Open" />
            break;
    }
}

@if (_open is not null)
{
    <SteamGameDetail AppId="_open.AppId" Title="@_open.Title" OnClose="() => _open = null" />
}

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(4);

    private static readonly (string Key, string Label, string Icon)[] Tabs =
    [
        ("overview", "Resumo", "dashboard"),
        ("library", "Biblioteca", "library"),
        ("steam", "Steam", "store"),
        ("games", "Todos os jogos", "games"),
    ];

    private StatsDto? _stats;
    private string? _error;
    private bool _loading = true;
    private bool _disposed;
    private string _tab = "overview";
    private StatsGameDto? _open;
    private Dictionary<long, int?> _players = [];

    public void Dispose() => _disposed = true;

    protected override async Task OnInitializedAsync()
    {
        await Library.EnsureLoadedAsync(CancellationToken.None);
        await LoadAsync();
    }

    private void Open(StatsGameDto game) => _open = game;

    private async Task LoadAsync()
    {
        _error = null;
        _loading = true;
        try
        {
            _stats = await Api.GetStatsAsync(CancellationToken.None);
            _loading = false;
            await LoadPlayersAsync();
            _ = PollAsync();
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
            _loading = false;
        }
    }

    private async Task LoadPlayersAsync()
    {
        if (_stats is null || _stats.Recent.Count == 0)
        {
            return;
        }

        try
        {
            _players = (await Api.GetPlayersNowAsync(_stats.Recent.Select(g => g.AppId), CancellationToken.None)).ToDictionary(p => p.AppId, p => p.Players);
        }
        catch (ApiException)
        {
        }
    }

    private async Task EnrichAsync()
    {
        try
        {
            EnrichmentStatusDto status = await Api.StartEnrichmentAsync(CancellationToken.None);
            if (_stats is not null)
            {
                _stats = _stats with { Enrichment = status };
            }

            _ = PollAsync();
        }
        catch (ApiException exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private async Task PollAsync()
    {
        while (!_disposed && _stats?.Enrichment.Running == true)
        {
            await Task.Delay(PollInterval);
            try
            {
                _stats = await Api.GetStatsAsync(CancellationToken.None);
                await InvokeAsync(StateHasChanged);
            }
            catch (ApiException)
            {
                return;
            }
        }
    }
}
