@implements IDisposable
@inject CartState Cart

<article class="promo">
    <button class="cart-toggle @(InCart is null ? string.Empty : "on")" @onclick="ToggleCartAsync" disabled="@_saving"
            title="@(InCart is null ? "Adicionar às Compras" : "Remover das Compras")">
        <Icon Name="@(InCart is null ? "cart-plus" : "check")" Size="18" />
    </button>
    <a class="promo-cover" href="@Item.Best.Url" target="_blank" rel="noopener noreferrer" title="Abrir na @Item.Best.Store">
        @if (Item.ImageUrl is { } image)
        {
            <img src="@image" alt="@Item.Title" loading="lazy" referrerpolicy="no-referrer" />
        }
        else
        {
            <span class="promo-noimg"><Icon Name="games" Size="36" /></span>
        }
        @if (Item.Best.DiscountPercent > 0)
        {
            <span class="promo-discount">-@Item.Best.DiscountPercent%</span>
        }
        <span class="promo-badges">
            @if (Item.OnWishlist)
            {
                <span class="badge badge-wish">Wishlist</span>
            }
            @if (Item.Owned)
            {
                <span class="badge badge-owned">Já tens</span>
            }
        </span>
    </a>

    <div class="promo-body">
        <div class="promo-title" title="@Item.Title">@Item.Title</div>

        <div class="promo-price">
            <strong>@DealFormat.Money(Item.Best.Price, Item.Best.Currency)</strong>
            @if (Item.Best.DiscountPercent > 0)
            {
                <s class="muted">@DealFormat.Money(Item.Best.OriginalPrice, Item.Best.Currency)</s>
            }
        </div>

        <div class="promo-meta">
            @if (Item.Best.DiscountPercent > 0)
            {
                <span class="promo-saving">Poupas @DealFormat.Money(Item.Saving, Item.Best.Currency)</span>
            }
            else
            {
                <span class="muted">Sem desconto</span>
            }
            <span class="store-tag">@Item.Best.Store</span>
        </div>

        @if (DealFormat.TimeLeft(Item.Best.EndsAt, DateTimeOffset.UtcNow) is { } left)
        {
            <span class="promo-ends"><Icon Name="clock" Size="13" /> @left</span>
        }

        @if (Item.Others.Count > 0)
        {
            <div class="promo-others">
                <span class="muted">Também em</span>
                @foreach (OfferDto other in Item.Others)
                {
                    <a href="@other.Url" target="_blank" rel="noopener noreferrer">@other.Store <b>@DealFormat.Money(other.Price, other.Currency)</b></a>
                }
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public PromotionDto Item { get; set; } = null!;

    private bool _saving;

    private CartItemDto? InCart => Cart.Find(CartKinds.Game, Item.Best.Url);

    protected override void OnInitialized() => Cart.Changed += OnCartChanged;

    public void Dispose() => Cart.Changed -= OnCartChanged;

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private async Task ToggleCartAsync()
    {
        _saving = true;
        if (InCart is { } existing)
        {
            await Cart.RemoveAsync(existing.Id);
        }
        else
        {
            OfferDto best = Item.Best;
            await Cart.SaveAsync(new CartItemRequest(CartKinds.Game, best.Store, Item.Title, best.Url, Item.ImageUrl, best.Price, best.OriginalPrice, best.Currency, best.EndsAt, null));
        }

        _saving = false;
    }
}
